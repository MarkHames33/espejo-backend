# Copy this file to .env and update the values below (NEVER commit .env)

# Application Settings
APP_NAME=LavaLustProducts
APP_KEY=
APP_ENV=development

# Database Configuration  (Aiven MySQL -> Overview -> Connection information)
DB_DRIVER=mysql
DB_HOST=your-service-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires SSL. Use true for Aiven, false for local MySQL (XAMPP).
DB_SSL=true
# Optional: path to Aiven ca.pem (leave empty to encrypt without verifying the CA)
DB_SSL_CA=
# Optional (best for Render): paste the full content of ca.pem here
DB_SSL_CA_CONTENT=

# For API  -> generate both with:  php lava jwt:generate
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Enable migration routes (/migrate, /status ...). Keep FALSE on the public server.
MIGRATION_ENABLED=false

# Allowed frontend origin(s), comma separated. Use your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173
